# Optional. When omitted, no Google Analytics script is loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Web fetch. Leave the values empty here. Real values belong in .env.local and Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
DATABASE_URL=
WORKER_TOKEN=
FETCH_API_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
YT_DLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# Self-hosted web API only: name of a header overwritten by your trusted ingress.
# Vercel uses its own verified client-IP header automatically.
FETCH_TRUSTED_IP_HEADER=
# Worker: bounded ext4 mount and durable result receipts, installed by ops units.
FETCH_WORK_ROOT=/var/lib/halaldl-fetch/work
FETCH_RECEIPT_ROOT=/var/lib/halaldl-fetch/receipts
# Extra public host/NAT addresses to deny in the media proxy (comma-separated).
FETCH_BLOCKED_ADDRESSES=
# Worker maintenance: refuse new public admission but drain existing jobs.
FETCH_INTAKE_PAUSED=false
