# Optional. When omitted, no Google Analytics script is loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Web fetch. Leave the values empty here. Real values belong in .env.local and Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
DATABASE_URL=
WORKER_TOKEN=
FETCH_API_URL=
# Optional site-to-worker doorbell. Empty URL keeps scheduled queue checks.
FETCH_WAKE_URL=
# New shared site/worker secret; distinct from worker and Vercel bypass tokens.
FETCH_WAKE_TOKEN=
# Worker only. Empty disables the listener; production uses this loopback bind.
FETCH_WAKE_BIND=127.0.0.1:18657
# Use the stable Vercel production alias for worker traffic. Keep this secret
# only on the worker, never in NEXT_PUBLIC_* variables or request URLs.
VERCEL_AUTOMATION_BYPASS_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
YT_DLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# Self-hosted web API only: name of a header overwritten by your trusted ingress.
# Vercel uses its own verified client-IP header automatically.
FETCH_TRUSTED_IP_HEADER=
# Worker: bounded ext4 mount and durable result receipts, installed by ops units.
FETCH_WORK_ROOT=/var/lib/halaldl-fetch/work
FETCH_RECEIPT_ROOT=/var/lib/halaldl-fetch/receipts
# Extra public host/NAT addresses to deny in the media proxy (comma-separated).
FETCH_BLOCKED_ADDRESSES=
# Worker maintenance: pause new processing claims; requests can remain queued.
FETCH_INTAKE_PAUSED=false
# API and Go worker must agree on the tested concurrency ceiling (1..12).
# Keep conservative values until the load report and workspace are approved.
FETCH_MAX_RUNNING=2
FETCH_MAX_DOWNLOADS=1
# yt-dlp still needs a JavaScript runtime for some sources.
# Empty uses the installed node executable on the service PATH.
JS_RUNTIME_PATH=
